PROGRAM;

// Sample program using all defined language constructs

// ------------------ Variables ------------------
var x = 10;               // integer
var y = 3.14;             // float
var isActive = true;      // boolean
var letter = 'A';         // char
var name = "Hello";       // string

// ------------------ Control Flow ------------------
if (isActive && x > 0) {
    print("Active and x positive");
} else {
    print("Inactive or x non-positive");
}

for (var i = 0; i < 5; i++) {
    print(i);
}

while (x != 0) {
    x = x - 1;
}

// ------------------ Noise Words ------------------
var int num = 100;
var float pi = 3.1415;
var bool flag = false;
var char c = 'Z';
var string str = "Test";

// ------------------ Operators ------------------
x = x + y;
y = y - x;
x = x * 2;
y = y / 2;
x = x /_ 3;       // divide_floor
y = y % 2;        // modulo
x++;              // increment
y--;              // decrement
z = x ^ 2;        // power

// ------------------ Logical Operators ------------------
if (x >= y && y <= z || !flag) {
    print("Logical operators used");
}

// ------------------ Delimiters ------------------
var a = (x + y) * (z - 1);

