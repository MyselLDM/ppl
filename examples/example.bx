PROGRAM;

var int x = 0;
var bool flag = true;
var int score = 85;
var int count = 3;
var bool running = true;
var bool ready = true;
var bool active = true;
var int tick = 0;

if (x < 10) {
    print("small");
}

if (flag == true) {
    print("enabled");
} else {
    print("disabled");
}

if (score >= 90) {
    print("A");
} else if (score >= 80) {
    print("B");
} else {
    print("C");
}

if (x > 0) {
    if (score > 0) {
        print("Quadrant 1");
    }
}

if (x == 0) {
    print("zero");
} else {
    if (x > 0) {
        print("positive");
    } else {
        print("negative");
    }
}

for (var i = 0; (i < 10); i = i + 1) {
    print(i);
}

for (var x = 0; (x < 3); x = x + 1) {
    for (var y = 0; (y < 2); y = y + 1) {
        print("(" + x + ", " + y + ")");
    }
}

for (var x = 0; (x < 3); x = x + 1) {
    for (var y = 0; (y < 3); y = y + 1) {
        for (var z = 0; (z < 3); z = z + 1) {
            print("point:" + x + "," + y + "," + z);
        }
    }
}

while (count > 0) {
    count = count - 1;
}

while (x < 5) {
    var y = 0;
    while (y < 3) {
        y = y + 1;
    }
    x = x + 1;
}

while (running == true) {
    if (tick % 2 == 0) {
        print("even");
    } else {
        print("odd");
    }
    tick = tick + 1;
}


if (ready == true) {
    for (var i = 0; (i < 5); i = i + 1) {
        print("start" + i);
    }
}


while (active == true) {
    for (var i = 0; (i < 4); i = i + 1) {
        if (i % 2 == 0) {
            print("even index");
        } else {
            print("odd index");
        }
    }
    active = false;
}
