PROGRAM;

// Variable declarations
var x = 10;
var y = 32 * 23 + 21 - 32;
var string greeting = "Hello, World!";
var z;

// Assignment statements
x = y + 15;
z = x * 2 - 5;

// Print and write statements
print("The value of x is:");
print(x);
write(greeting);

// If-else statements
if (x > y) {
    print("x is greater than y");
} else {
    print("x is less than or equal to y");
}

// While loop
while (x > 0) {
    print(x);
    x = x - 1;
}

// For loop
for (var i = 0; i < 5; i++) {
    print("Iteration number:");
    print(i);
    y = y + i;
}

// More assignments with arithmetic
z = (y + x) / 2;
y = y - z;

// Nested if inside while
var counter = 0;
while (counter < 3) {
    if (counter % 2 == 0) {
        print("Even counter:");
        print(counter);
    } else {
        print("Odd counter:");
        print(counter);
    }
    counter++;
}

var int guess;
while(guess != 100) {
  print("Guess the number: ");
  write(guess);
}

// End of program
print("Program completed successfully.");