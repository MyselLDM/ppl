var int i = 1;
while (i <= 3) {
    var int j = 1;
    while (j <= i + 1) {
        var int k = 5;
        while (k > 0) {
            print("i=" + i + " j=" + j + " k=" + k);
            if ((i + j + k) % 4 == 0)
                {print(">>> divisible by 4!");}
            if (k == 3 && j == 2)
                {print("=== special middle state ===");}
            k--;   // inner loop
        }
        j++;   // mid loop
    }
    i++;   // outer loop
}

// For loop
for (var i = 0; i < 5; i++) {
    print("Iteration number:");
    print(i);
    y = y + i;
}

// For loop
